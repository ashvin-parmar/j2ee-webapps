xhr.responseType = 'json'     //remove this line [2]

//update code based on this and json response [error from 1 change]
xhr.onload=()=>{
if (xhr.status >= 200 && xhr.status < 300) 
{
resolve(JSON.parse(xhr.responseText));    //here PARSE if success
} 
else 
{
reject({
status: xhr.status,
message: xhr.responseText
});
}
};


