<!DOCTYPE taglib
        PUBLIC "-//Sun Microsystems, Inc.//DTD JSP Tag Library 1.2//EN"
        "http://java.sun.com/dtd/web-jsptaglibrary_1_2.dtd">

<!-- a tag library descriptor -->

<taglib>
  <tlib-version>1.0</tlib-version>
  <jsp-version>1.2</jsp-version>
  <short-name>tmtag</short-name>
  <description>
	My Custom Tag  
</description>
  <!-- This is a dummy tag solely to satisfy DTD requirements -->
  <tag>
    <name>If</name>
    <tag-class>com.ashvin.hr.nexus.tags.IfTagHandler</tag-class>
    <description>
	To process something if condition is true    
</description>
    <attribute>
        <name>condition</name>
        <required>true</required>		<!-- mandatory to provide condition attribute while using If tag -->
	<rtexprvalue>true</rtexprvalue>		<!-- run time expression value allowed -->
    </attribute>
  </tag>

<tag>
<name>FormID</name>
<tag-class>com.ashvin.hr.nexus.tags.FormIDTagHandler</tag-class>
<description>To create specific unique form id</description>
</tag>

<tag>
<name>FormResubmitted</name>
<tag-class>com.ashvin.hr.nexus.tags.FormResubmittedTagHandler</tag-class>
<description>To trigger form resubmission based on same unique id from request and session object.</description>
</tag>
<tag>
<name>ValidateLogin</name>
<tag-class>com.ashvin.hr.nexus.tags.ValidateLoginTagHandler</tag-class>
<description>To check that user did login or not.</description>
</tag>

  <tag>
    <name>Module</name>
    <tag-class>com.ashvin.hr.nexus.tags.ModuleTagHandler</tag-class>
    <description>
	To process the module
</description>
    <attribute>
        <name>name</name>
        <required>true</required>		<!-- mandatory to provide condition attribute while using If tag -->
	<rtexprvalue>true</rtexprvalue>		<!-- run time expression value allowed -->
    </attribute>
  </tag>


<tag>
<name>EntityList</name>
<tag-class>com.ashvin.hr.nexus.tags.EntityListTagHandler</tag-class>
<description>To traverse on generalised list of any class</description>
<attribute>
	<name>populateClass</name>
	<required>true</required>
	<rtexprvalue>true</rtexprvalue>
</attribute>
<attribute>
	<name>populateMethod</name>
	<required>true</required>
	<rtexprvalue>true</rtexprvalue>
</attribute>
<attribute>
	<name>name</name>
	<required>true</required>
	<rtexprvalue>true</rtexprvalue>
</attribute>
</tag>

  <tag>
<name>Designations</name>
<tag-class>com.ashvin.hr.nexus.tags.DesignationsTagHandler</tag-class>
<description>
Custom tag for iterate on DL Designations data
</description>
<attribute>
</attribute>  
</tag>
</taglib>
